# Copy to .env on the server. Never commit it. Generate secrets with: ./scripts/gen-secrets.sh
PUBLIC_URL=https://fleet.example.com   # the address people type, exactly (scheme + host, no trailing slash)
HTTP_PORT=80                           # port the web container listens on (put HTTPS in front of it)
# Required: PostgreSQL connection URI from Supabase Dashboard > Connect > Postgres.
# Keep the password private and URL-encode special characters in it.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=memory          # set to redis to share limits across backend instances
EMAIL_DELIVERY_BACKEND=sync        # set to celery to queue transactional email
SECRET_KEY=                            # 48+ random characters; the app refuses to start in production with a placeholder
OSRM_BASE_URL=                        # optional OSRM server, e.g. https://router.project-osrm.org
OSRM_PROFILE=driving
GROQ_API_KEY=                          # optional; without it only the AI chat and report summaries are off
GROQ_MODEL=openai/gpt-oss-120b
# Resend (backend only). Use a sender/domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# AfroMessage (backend only). Obtain the identifier ID from the AfroMessage dashboard.
AFROMESSAGE_API_KEY=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
SMS_TIMEOUT_SECONDS=10
# Supabase Storage (service-role key is backend-only; create a private bucket first).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fleetmind-documents
DOCUMENT_MAX_BYTES=10000000
# SMTP fallback when Resend is not configured.
SMTP_HOST=
SMTP_PORT=587                          # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FleetMind <no-reply@fleet.example.com>
