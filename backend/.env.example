# Copy to .env — never commit real keys
# Required: use the PostgreSQL connection URI from Supabase Dashboard > Connect > Postgres.
# Keep the password in this local, ignored file; URL-encode special characters in it.
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=memory
EMAIL_DELIVERY_BACKEND=sync
SECRET_KEY=replace_with_long_random_string
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# AI provider (backend only)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional AI tuning: low | medium | high, request timeout (s), max data-tool calls per question
GROQ_REASONING_EFFORT=medium
AI_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ROUNDS=5
# Simulated GPS (demo): update interval in seconds and demo speed-up factor
SIM_TICK_SECONDS=2
SIM_SPEED_BOOST=8
OSRM_BASE_URL=
OSRM_PROFILE=driving
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FleetMind <no-reply@localhost>
# Resend (backend only). EMAIL_FROM must use a sender/domain verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# AfroMessage (backend only). Obtain the identifier ID from the AfroMessage dashboard.
AFROMESSAGE_API_KEY=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
SMS_TIMEOUT_SECONDS=10
# Supabase Storage (private bucket; service-role key stays in the backend only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fleetmind-documents
DOCUMENT_MAX_BYTES=10000000
SEED_DEMO_ON_START=true
